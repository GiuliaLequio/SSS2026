pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build FE') {
      steps {
        sh 'docker build -t fe:${BUILD_NUMBER} -f 5-esercitazioneJenkins/frontend/Dockerfile 5-esercitazioneJenkins/frontend'
      }
    }

    stage('Build BE') {
      steps {
        sh 'docker build -t be:${BUILD_NUMBER} -f 5-esercitazioneJenkins/backend/Dockerfile 5-esercitazioneJenkins/backend'
      }
    }
  }
}