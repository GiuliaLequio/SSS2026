pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build FE') {
      steps {
        sh 'docker build -t fe:${BUILD_NUMBER} -f 4-esercitazioneDockerCompose/frontend/Dockerfile 4-esercitazioneDockerCompose/frontend'
      }
    }

    stage('Build BE') {
      steps {
        sh 'docker build -t be:${BUILD_NUMBER} -f 4-esercitazioneDockerCompose/backend/Dockerfile 4-esercitazioneDockerCompose/backend'
      }
    }
  }
}